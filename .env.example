# ─── Loso environment variables ────────────────────────────────────────────
# Copy to .env (never commit .env). Values below are placeholders only.

# MongoDB connection string. Prisma needs a REPLICA SET (MongoDB Atlas clusters are replica sets).
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/loso?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/loso?replicaSet=rs0   (mongod must be started with --replSet rs0)
DATABASE_URL="mongodb+srv://USER:CHANGE_ME@cluster0.example.mongodb.net/loso?retryWrites=true&w=majority"

# Public base URL of the app (used in password-reset links).
APP_URL="http://localhost:3000"

# Time zone for displaying dates.
LOSO_TIMEZONE="Africa/Addis_Ababa"
LOSO_DEFAULT_CITY="Hawassa"

# ─── File storage ───────────────────────────────────────────────────────────
# "cloudinary" is recommended on Vercel (uploads are stored as private Cloudinary assets).
# CLOUDINARY_CLOUD_NAME=""     # Cloudinary dashboard → "Cloud name"
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_FOLDER="looso"
# "local" stores files in a private folder on disk (development / single server only).
# "s3" uses any S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...). Required in production.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"

# ─── First super admin (used once by `npm run admin:create`) ────────────────
# Leave empty in .env; pass on the command line instead so the password is not stored.
# SUPER_ADMIN_NAME=""
# SUPER_ADMIN_PHONE=""
# SUPER_ADMIN_PASSWORD=""

# ─── Payment providers (NOT implemented until merchant credentials exist) ──
# Only the manual staff-reviewed payment flow is active. When a Chapa / Telebirr merchant
# account is available, implement the provider in lib/payments/providers.ts and add e.g.:
# CHAPA_SECRET_KEY=""
# CHAPA_WEBHOOK_SECRET=""
# TELEBIRR_APP_ID=""
# TELEBIRR_APP_KEY=""
# TELEBIRR_MERCHANT_CODE=""
# TELEBIRR_PRIVATE_KEY=""

# ─── Notification channels (NOT implemented until a provider is chosen) ────
# In-app notifications always work. Add an SMS/email channel in lib/notifications.ts, e.g.:
# SMS_PROVIDER_API_KEY=""
# SMTP_URL=""
